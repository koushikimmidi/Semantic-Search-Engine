# Copy this file to .env and fill in your own values. Never commit .env.

# ---- Gmail IMAP (reading support emails) ----
# Use a Gmail App Password, not your normal password.
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USERNAME=you@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_FOLDER=INBOX
EMAIL_LIMIT=10

# ---- SMTP (sending automatic replies) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password

# ---- Automation ----
# Set to true only after SMTP is configured and tested.
AUTOMATION_SEND_EMAILS=false
AUTOMATION_INTERVAL_SECONDS=300

# ---- Local LLM (Ollama) ----
OLLAMA_MODEL=gemma4:latest
# OLLAMA_HOST=http://localhost:11434

# Mark processed emails as read in Gmail (otherwise they stay unread
# and are de-duplicated by Message-ID).
EMAIL_MARK_AS_READ=false

# ---- API authentication ----
# Leave both empty for local development (auth disabled, warning at
# startup). Set long random values before exposing the API.
#   agent: email automation + review queue
#   admin: everything, incl. documents and the scheduler
ADMIN_API_KEY=
AGENT_API_KEY=

# ---- Retrieval / answer tuning (defaults shown) ----
# CHUNK_SIZE=700
# RERANK_CANDIDATES=10
# RAG_MAX_SOURCES=4
# INTENT_CLASSIFIER=true
# CONFIDENCE_VERY_HIGH_THRESHOLD=3.0
# CONFIDENCE_HIGH_THRESHOLD=0.5
# CONFIDENCE_MIN_SCORE_GAP=0.5
# CONFIDENCE_MEDIUM_THRESHOLD=-3.0
