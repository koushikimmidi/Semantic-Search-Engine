# ---------------------------------------------------------------
# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit real passwords or keys.
# ---------------------------------------------------------------

# ---- Access ----------------------------------------------------
# ADMIN_API_KEY is required for the first-time admin setup in the
# web UI (it proves you own the installation). Use a long random
# value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Optional key with employee-level access, for scripts/integrations.
AGENT_API_KEY=

# Signing secret for login sessions. Generated automatically and
# stored in AUTOMATION_DATA_DIR if left empty.
# AUTH_SECRET=
# AUTH_TOKEN_TTL_SECONDS=43200

# ---- Local LLM (Ollama) ---------------------------------------
OLLAMA_MODEL=gemma4:latest
# OLLAMA_HOST=http://localhost:11434
# LLM_MAX_TOKENS=220

# ---- Support inbox: reading email (IMAP) -----------------------
# For Gmail use an App Password (Google Account > Security >
# 2-Step Verification > App passwords), not your normal password.
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USERNAME=you@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_FOLDER=INBOX
EMAIL_LIMIT=10
# Mark handled emails as read (otherwise they stay unread and are
# de-duplicated by Message-ID). Can also be changed in System.
EMAIL_MARK_AS_READ=false

# ---- Support inbox: sending replies (SMTP) ---------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password

# ---- Automation ------------------------------------------------
# Keep false until you have tested replies. Can also be changed in System.
AUTOMATION_SEND_EMAILS=false
AUTOMATION_INTERVAL_SECONDS=300

# ---- Storage (defaults shown) ----------------------------------
# KNOWLEDGE_BASE_PATH=data/documents/education
# AUTOMATION_DATA_DIR=data/automation
# EMBEDDING_CACHE_PATH=data/index/embedding_cache.pkl

# ---- Retrieval & answer tuning (defaults shown) ----------------
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# CHUNK_SIZE=700
# RERANK_CANDIDATES=10
# RAG_MAX_SOURCES=4
# INTENT_CLASSIFIER=true
# CONFIDENCE_VERY_HIGH_THRESHOLD=3.0
# CONFIDENCE_HIGH_THRESHOLD=0.5
# CONFIDENCE_MIN_SCORE_GAP=0.5
# CONFIDENCE_MEDIUM_THRESHOLD=-3.0
