# Copy this file to .env and fill in your own values. Never commit .env.

# ---- Gmail IMAP (reading support emails) ----
# Use a Gmail App Password, not your normal password.
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USERNAME=you@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_FOLDER=INBOX
EMAIL_LIMIT=10

# ---- SMTP (sending automatic replies) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password

# ---- Automation ----
# Set to true only after SMTP is configured and tested.
AUTOMATION_SEND_EMAILS=false
AUTOMATION_INTERVAL_SECONDS=300

# ---- Local LLM (Ollama) ----
OLLAMA_MODEL=gemma4:latest
# OLLAMA_HOST=http://localhost:11434
